@using Microsoft.AspNet.Identity
@{
	// Get current controller to highlight the active sidebar link
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title - EduAccess Admin</title>
	@Styles.Render("~/Content/css")
	@Scripts.Render("~/bundles/modernizr")

	<style>
		/* --- Admin Global Layout --- */
		body {
			background-color: #f8f9fb;
			color: #1a2733;
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
			overflow-x: hidden;
			margin: 0;
		}

		/* --- Sidebar --- */
		.admin-sidebar {
			width: 260px;
			background-color: #ffffff;
			border-right: 1px solid #e6e9ee;
			color: #1a2733;
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			z-index: 1000;
			display: flex;
			flex-direction: column;
			transition: all 0.3s;
		}

		.admin-brand {
			padding: 1.5rem;
			font-size: 1.25rem;
			font-weight: 800;
			color: #0d7a6e;
			text-decoration: none;
			display: flex;
			align-items: center;
			gap: 0.75rem;
			border-bottom: 1px solid #e6e9ee;
		}

			.admin-brand:hover {
				color: #0d7a6e;
				text-decoration: none;
			}

			.admin-brand::before {
				content: '';
				display: inline-block;
				width: 10px;
				height: 10px;
				background-color: #20c997;
				border-radius: 50%;
			}

		.admin-nav {
			padding: 1.5rem 0;
			flex: 1;
			overflow-y: auto;
		}

		.admin-nav-link {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			padding: 0.85rem 1.5rem;
			color: #5a6571;
			text-decoration: none;
			font-weight: 500;
			font-size: 0.95rem;
			transition: 0.2s;
			border-left: 3px solid transparent;
		}

			.admin-nav-link:hover {
				color: #0d7a6e;
				background-color: #fafbfc;
			}

			.admin-nav-link.active {
				color: #0d7a6e;
				background-color: #f0f7f4;
				border-left: 3px solid #0d7a6e;
				font-weight: 600;
			}

			.admin-nav-link svg {
				width: 20px;
				height: 20px;
			}

		/* --- Main Content Wrapper --- */
		.admin-main {
			margin-left: 260px;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* --- Top Bar --- */
		.admin-topbar {
			background: #ffffff;
			height: 70px;
			border-bottom: 1px solid #e6e9ee;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 2rem;
			position: sticky;
			top: 0;
			z-index: 999;
		}

		.topbar-user {
			display: flex;
			align-items: center;
			gap: 1rem;
		}

		.topbar-user-avatar {
			width: 36px;
			height: 36px;
			background: #e6f2f0;
			color: #0d7a6e;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: bold;
			font-size: 0.9rem;
		}

		/* --- Logout Button Styling --- */
		.btn-logout {
			background: transparent;
			border: 1px solid #e6e9ee;
			color: #5a6571;
			font-size: 0.85rem;
			font-weight: 600;
			padding: 0.4rem 0.85rem;
			border-radius: 0.375rem;
			transition: 0.2s;
			text-decoration: none;
		}

			.btn-logout:hover {
				background: #fcebe9;
				color: #e05545;
				border-color: #e05545;
			}

		/* --- Page Content Padding --- */
		.admin-content {
			padding: 2rem;
			flex: 1;
		}

		/* --- Mobile Responsive --- */
		@@media (max-width: 991px) {
			.admin-sidebar {
				transform: translateX(-100%);
			}

			.admin-main {
				margin-left: 0;
			}
		}
	</style>
</head>
<body>
	<!-- Sidebar -->
	<aside class="admin-sidebar">
		<a href="@Url.Action("Index", "AdminDashboard")" class="admin-brand">
			EduAccess Admin
		</a>

		<nav class="admin-nav">
			<!-- Dashboard -->
			<a href="@Url.Action("Index", "AdminDashboard")"
			   class="admin-nav-link @(currentAction == "Index" && currentController == "AdminDashboard" ? "active" : "")">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
				Dashboard
			</a>

			<!-- Users -->
			<a href="@Url.Action("Users", "AdminDashboard")"
			   class="admin-nav-link @(currentAction == "Users" ? "active" : "")">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
				Users
			</a>

			<!-- Institutions -->
			<a href="@Url.Action("Institutions", "AdminDashboard")"
			   class="admin-nav-link @(currentAction == "Institutions" ? "active" : "")">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
				Institutions
			</a>

			<!-- Bursaries -->
			<a href="@Url.Action("Bursaries", "AdminDashboard")"
			   class="admin-nav-link @(currentAction == "Bursaries" ? "active" : "")">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
				Bursaries
			</a>

			<div style="border-top: 1px solid #e6e9ee; margin: 1rem 0;"></div>

			<a href="@Url.Action("Index", "Home")" class="admin-nav-link">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
				Back to Site
			</a>
		</nav>
	</aside>

	<!-- Main Content -->
	<div class="admin-main">
		<!-- Top Bar -->
		<header class="admin-topbar">
			<h5 class="m-0 fw-bold text-dark">@ViewBag.Title</h5>

			<div class="topbar-user">
				<span class="text-muted" style="font-size: 0.85rem;">Admin Panel</span>
				<div class="topbar-user-avatar" title="@User.Identity.GetUserName()">
					@User.Identity.GetUserName().Substring(0, 1).ToUpper()
				</div>

				@using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "m-0 ms-2" }))
				{
					@Html.AntiForgeryToken()
					<button type="submit" class="btn-logout">Log off</button>
				}
			</div>
		</header>

		<!-- Content Area -->
		<main class="admin-content">
			@RenderBody()
		</main>
	</div>

	@Scripts.Render("~/bundles/jquery")
	@Scripts.Render("~/bundles/bootstrap")
	@RenderSection("scripts", required: false)
</body>
</html>