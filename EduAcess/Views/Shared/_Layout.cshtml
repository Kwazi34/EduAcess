<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title - EduAccess</title>
	@Styles.Render("~/Content/css")
	@Scripts.Render("~/bundles/modernizr")
	@using Microsoft.AspNet.Identity
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

	<style>
		/* --- Global Pro-Style Layout --- */
		body {
			background-color: #ffffff;
			color: #1a2733;
			font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
		}

		/* --- Clean White Navbar --- */
		.navbar-clean {
			background-color: #ffffff !important;
			border-bottom: 1px solid #e6e9ee;
			padding-top: 1rem;
			padding-bottom: 1rem;
		}

		.navbar-brand-clean {
			font-weight: 800;
			font-size: 1.5rem;
			color: #0d7a6e !important;
			letter-spacing: -0.5px;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

			.navbar-brand-clean::before {
				content: '';
				display: inline-block;
				width: 12px;
				height: 12px;
				background-color: #20c997;
				border-radius: 50%;
			}

		/* Public Nav Links */
		.navbar-clean .nav-link {
			color: #5a6571 !important;
			font-weight: 500;
			font-size: 0.95rem;
			transition: color 0.2s;
			padding: 0.5rem 1rem !important;
		}

			.navbar-clean .nav-link:hover {
				color: #0d7a6e !important;
			}

		/* Separator between public and private links */
		.nav-separator {
			width: 1px;
			height: 20px;
			background-color: #e6e9ee;
			align-self: center;
			margin: 0 0.5rem;
		}

		/* Auth Buttons */
		.btn-nav-signin {
			color: #0d7a6e !important;
			font-weight: 600;
			font-size: 0.9rem;
			text-decoration: none;
			padding: 0.5rem 1rem;
			border: 1px solid transparent;
			transition: 0.2s;
		}

			.btn-nav-signin:hover {
				color: #095e54 !important;
				background-color: #f8f9fb;
				border-radius: 0.375rem;
			}

		.btn-nav-getstarted {
			background-color: #0d7a6e;
			color: #ffffff !important;
			font-weight: 600;
			font-size: 0.9rem;
			border: 1px solid #0d7a6e;
			border-radius: 0.375rem;
			padding: 0.5rem 1.25rem;
			text-decoration: none;
			transition: 0.2s;
		}

			.btn-nav-getstarted:hover {
				background-color: #095e54;
				border-color: #095e54;
				transform: translateY(-1px);
			}

		/* User Avatar Dropdown */
		.user-pill {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			text-decoration: none;
			color: #1a2733;
			font-size: 0.9rem;
			font-weight: 600;
			padding: 0.3rem 0.75rem 0.3rem 0.3rem;
			border-radius: 999px;
			border: 1px solid #e6e9ee;
			transition: 0.2s;
		}

			.user-pill:hover {
				background-color: #f8f9fb;
				border-color: #cbd5e1;
			}

		.user-avatar {
			width: 28px;
			height: 28px;
			background: #f0f7f4;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #0d7a6e;
			font-size: 0.75rem;
			font-weight: 800;
		}

		/* --- Dark Multi-Column Footer --- */
		.site-footer {
			background-color: #0f172a;
			color: #94a3b8;
			padding: 4rem 0 2rem 0;
			margin-top: auto;
		}

			.site-footer h5 {
				color: #ffffff;
				font-weight: 700;
				margin-bottom: 1.5rem;
				font-size: 1rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.site-footer .brand-logo {
				color: #ffffff;
				font-weight: 800;
				font-size: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 1rem;
				text-decoration: none;
			}

				.site-footer .brand-logo::before {
					content: '';
					display: inline-block;
					width: 12px;
					height: 12px;
					background-color: #0d7a6e;
					border-radius: 50%;
				}

			.site-footer p {
				font-size: 0.9rem;
				line-height: 1.6;
				margin-bottom: 1rem;
			}

			.site-footer ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.site-footer li {
				margin-bottom: 0.6rem;
			}

			.site-footer a {
				color: #94a3b8;
				text-decoration: none;
				font-size: 0.9rem;
				transition: color 0.2s;
			}

				.site-footer a:hover {
					color: #ffffff;
				}

			.site-footer .footer-bottom {
				border-top: 1px solid #1e293b;
				margin-top: 3rem;
				padding-top: 1.5rem;
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				font-size: 0.85rem;
			}

				.site-footer .footer-bottom a {
					margin-left: 1.5rem;
				}

		.body-content {
			flex: 1 0 auto;
			padding-top: 0;
			padding-bottom: 0;
		}

		.footer-contact-icon {
			display: inline-block;
			margin-right: 0.5rem;
			color: #0d7a6e;
		}
	</style>
</head>
<body>
	<!-- Clean Navbar -->
	<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-clean sticky-top">
		<div class="container">
			@Html.ActionLink("EduAccess", "Index", "Home", new { area = "" }, new { @class = "navbar-brand navbar-brand-clean" })

			<button type="button" class="navbar-toggler border-0" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation"
					aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
				<!-- LEFT SIDE: Public Links -->
				<ul class="navbar-nav ms-4 gap-2">
					<li class="nav-item">
						@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })
					</li>
					<li class="nav-item">
						@Html.ActionLink("Programmes", "Index", "Programmes", new { area = "" }, new { @class = "nav-link" })
					</li>
					<li class="nav-item">
						@Html.ActionLink("Funding", "Index", "Funding", new { area = "" }, new { @class = "nav-link" })
					</li>
					<li class="nav-item">
						@Html.ActionLink("Plan B", "Index", "PlanB", new { area = "" }, new { @class = "nav-link" })
					</li>
					<li class="nav-item">
						@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })
					</li>
					<li class="nav-item">
						@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })
					</li>
				</ul>

				<!-- RIGHT SIDE: Auth / User Actions -->
				<div class="d-flex align-items-center gap-2">
					@if (Request.IsAuthenticated)
					{
						// Show Admin link ONLY to admins
						if (User.IsInRole("Admin"))
						{
							<a href="@Url.Action("Index", "AdminDashboard")" class="btn-nav-signin" style="color: #b45309 !important; font-weight: 700;">
								⚙ Admin Panel
							</a>
						}

						// Show Dashboard link ONLY to learners or admins
						if (User.IsInRole("Learner") || User.IsInRole("Admin"))
						{
							<a href="@Url.Action("Index", "Dashboard")" class="btn-nav-signin" style="font-weight: 700;">
								Dashboard
							</a>
						}

						<div class="nav-separator"></div>

						using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "m-0" }))
						{
							@Html.AntiForgeryToken()
							<div class="d-flex align-items-center gap-2">
								<a href="@Url.Action("Index", "Manage")" class="user-pill">
									<div class="user-avatar">
										@User.Identity.GetUserName().Substring(0, 1).ToUpper()
									</div>
									<span class="d-none d-md-inline">@User.Identity.GetUserName().Split('@')[0]</span>
								</a>
								<a href="javascript:document.getElementById('logoutForm').submit()" class="btn-nav-signin">Log off</a>
							</div>
						}
					}
					else
					{
						<a href="@Url.Action("Login", "Account")" class="btn-nav-signin">Sign in</a>
						<a href="@Url.Action("Register", "Account")" class="btn-nav-getstarted">Get started</a>
					}
				</div>
			</div>
		</div>
	</nav>

	<!-- Main Content Area -->
	<div class="body-content">
		@RenderBody()
	</div>

	<!-- Rich Dark Footer -->
	<footer class="site-footer">
		<div class="container">
			<div class="row g-4">

				<div class="col-lg-4 col-md-6">
					<a href="@Url.Action("Index", "Home")" class="brand-logo">
						EduAccess
					</a>
					<p>
						An AI-powered guide from matric to what comes next. Personalised study options, funding, and Plan B pathways for every South African matriculant.
					</p>
					<p style="font-size: 0.85rem; color: #64748b;">
						Free for learners. Always.
					</p>
				</div>

				<div class="col-lg-2 col-md-6">
					<h5>Solutions</h5>
					<ul>
						<li><a href="@Url.Action("Index", "Home")#features">Discover</a></li>
						<li><a href="@Url.Action("Index", "Programmes")">Browse Programmes</a></li>
						<li><a href="@Url.Action("Index", "Funding")">Find Funding</a></li>
						<li><a href="@Url.Action("Index", "PlanB")">Plan B</a></li>
					</ul>
				</div>

				<div class="col-lg-2 col-md-6">
					<h5>Company</h5>
					<ul>
						<li><a href="@Url.Action("About", "Home")">About</a></li>
						<li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
						<li><a href="#">How it works</a></li>
						<li><a href="#">Help centre</a></li>
					</ul>
				</div>

				<div class="col-lg-4 col-md-6">
					<h5>Get in touch</h5>
					<ul>
						<li>
							<svg class="footer-contact-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
								<path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
							</svg>
							<a href="mailto:hello@eduaccess.co.za">hello@eduaccess.co.za</a>
						</li>
						<li>
							<svg class="footer-contact-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
								<path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z" />
							</svg>
							<a href="tel:+27310000000">+27 31 000 0000</a>
						</li>
						<li>
							<svg class="footer-contact-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
								<path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
							</svg>
							<span>Durban, South Africa</span>
						</li>
					</ul>
				</div>
			</div>

			<div class="footer-bottom">
				<div>
					&copy; @DateTime.Now.Year - EduAccess. All rights reserved.
				</div>
				<div>
					<a href="#">Privacy Policy</a>
					<a href="#">Terms of Use</a>
					<a href="#">Back to top &uarr;</a>
				</div>
			</div>
		</div>
	</footer>

	@Scripts.Render("~/bundles/jquery")
	@Scripts.Render("~/bundles/bootstrap")

	<!-- Chat Bot Global Widget -->
	@Html.Partial("_ChatBot")

	@RenderSection("scripts", required: false)
</body>
</html>