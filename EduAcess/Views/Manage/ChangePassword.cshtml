@model EduAcess.Models.ChangePasswordViewModel
@{
	ViewBag.Title = "Change Password";
}

<style>
	/* Reset top padding to allow full-height layout */
	.body-content {
		padding-top: 0 !important;
		padding-bottom: 0 !important;
	}

	.auth-page-wrapper {
		min-height: calc(100vh - 73px);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
		padding: 2rem;
	}

	/* The main container acting as the split card */
	.auth-split-container {
		display: flex;
		width: 100%;
		max-width: 1000px;
		background: #ffffff;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		border: 1px solid #eef1f4;
		overflow: hidden;
		min-height: 600px;
	}

	/* Left Side: Security / Brand */
	.auth-left-brand {
		flex: 0 0 40%;
		background: linear-gradient(rgba(13, 122, 110, 0.85), rgba(9, 94, 84, 0.95)), url('https://images.unsplash.com/photo-1555949963-aa79dcee981c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');
		background-size: cover;
		background-position: center;
		padding: 4rem 3rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: #ffffff;
	}

		.auth-left-brand h2 {
			font-size: 2.2rem;
			font-weight: 800;
			line-height: 1.2;
			margin-bottom: 1rem;
			letter-spacing: -1px;
		}

		.auth-left-brand p {
			font-size: 1rem;
			opacity: 0.9;
			max-width: 300px;
			line-height: 1.6;
		}

	/* Right Side: Form */
	.auth-right-form {
		flex: 0 0 60%;
		padding: 4rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

		.auth-right-form h3 {
			font-size: 1.8rem;
			font-weight: 800;
			color: #1a2733;
			margin-bottom: 0.5rem;
		}

		.auth-right-form .subtitle {
			color: #5a6571;
			margin-bottom: 2rem;
			font-size: 0.95rem;
		}

	/* Form Inputs */
	.form-group-custom {
		margin-bottom: 1.25rem;
	}

		.form-group-custom label {
			font-weight: 500;
			color: #1a2733;
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
			display: block;
		}

	.form-control-custom {
		width: 100%;
		padding: 0.75rem 1rem;
		font-size: 1rem;
		border: 1px solid #cfd6de;
		border-radius: 0.375rem;
		background-color: #fafbfc;
		transition: 0.2s;
	}

		.form-control-custom:focus {
			background-color: #ffffff;
			border-color: #0d7a6e;
			outline: none;
			box-shadow: 0 0 0 3px rgba(13, 122, 110, 0.1);
		}

	/* Password wrapper */
	.password-wrapper {
		position: relative;
	}

	.show-password-btn {
		position: absolute;
		right: 10px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: #0d7a6e;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
	}

	/* Submit Button */
	.btn-submit-save {
		background-color: #f5a623; /* Amber to highlight the forced action */
		color: #1a2733;
		font-weight: 800;
		padding: 0.85rem;
		border-radius: 0.375rem;
		border: none;
		width: 100%;
		transition: background 0.2s;
		margin-top: 1rem;
	}

		.btn-submit-save:hover {
			background-color: #e0941a;
			color: #1a2733;
		}

	/* Alerts */
	.alert-warning-custom {
		background-color: #fff8eb;
		color: #856404;
		border: 1px solid #ffeeba;
		border-radius: 0.375rem;
		padding: 1rem;
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	/* Responsive */
	@@media (max-width: 991px) {
		.auth-split-container {
			flex-direction: column;
			min-height: auto;
		}

		.auth-left-brand {
			display: none;
		}

		.auth-right-form {
			padding: 2rem;
		}
	}
</style>

<div class="auth-page-wrapper">
	<div class="auth-split-container">

		<!-- Left Side: Security Brand -->
		<div class="auth-left-brand">
			<h2>Secure your account.</h2>
			<p>For your security, you are required to update your password before accessing the EduAccess dashboard.</p>
		</div>

		<!-- Right Side: Form -->
		<div class="auth-right-form">
			<h3>Change Password</h3>
			<p class="subtitle">Please create a new, strong password to continue.</p>

			<!-- Show Warning if they were forced here -->
			<div class="alert-warning-custom">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
					<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
				</svg>
				<div>
					<strong>First-time login detected.</strong> You must change your temporary password before you can access the system.
				</div>
			</div>

			@using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form", @class = "m-0" }))
			{
				@Html.AntiForgeryToken()
				@Html.ValidationSummary("", new { @class = "text-danger mb-3" })

				<!-- Old Password -->
				<div class="form-group-custom">
					@Html.LabelFor(m => m.OldPassword)
					<div class="password-wrapper">
						@Html.PasswordFor(m => m.OldPassword, new { @class = "form-control-custom", placeholder = "Enter your temporary password", id = "oldPassword" })
						<button type="button" class="show-password-btn" onclick="togglePassword('oldPassword', this)">Show</button>
					</div>
					@Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small d-block mt-1" })
				</div>

				<!-- New Password -->
				<div class="form-group-custom">
					@Html.LabelFor(m => m.NewPassword)
					<div class="password-wrapper">
						@Html.PasswordFor(m => m.NewPassword, new { @class = "form-control-custom", placeholder = "Create a new password", id = "newPassword" })
						<button type="button" class="show-password-btn" onclick="togglePassword('newPassword', this)">Show</button>
					</div>
					@Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small d-block mt-1" })
					<small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Must be at least 8 characters long, contain an uppercase letter, a lowercase letter, and a number.</small>
				</div>

				<!-- Confirm Password -->
				<div class="form-group-custom mb-4">
					@Html.LabelFor(m => m.ConfirmPassword)
					<div class="password-wrapper">
						@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control-custom", placeholder = "Confirm your new password", id = "confirmPassword" })
						<button type="button" class="show-password-btn" onclick="togglePassword('confirmPassword', this)">Show</button>
					</div>
					@Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small d-block mt-1" })
				</div>

				<!-- Submit -->
				<button type="submit" class="btn-submit-save shadow-sm">Update Password & Continue</button>
			}
		</div>

	</div>
</div>

@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.textContent = "Hide";
            } else {
                input.type = "password";
                btn.textContent = "Show";
            }
        }
	</script>
}