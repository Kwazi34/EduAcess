@model EduAcess.Models.IndexViewModel
@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin
@using EduAcess

@{
	ViewBag.Title = "My Account";

	// Fix: ApplicationUserManager is in the root EduAcess namespace, not EduAcess.Models
	var currentUser = HttpContext.Current.GetOwinContext().GetUserManager<ApplicationUserManager>().FindById(User.Identity.GetUserId());
	bool hasFaceId = currentUser != null && !string.IsNullOrEmpty(currentUser.FaceDescriptor);
}

<style>
	/* --- Dashboard Global Styling --- */
	.dashboard-bg {
		background-color: #f8f9fb;
		min-height: calc(100vh - 73px);
		padding: 3rem 0;
	}

	/* --- Profile Header --- */
	.profile-header {
		background: #ffffff;
		border-radius: 1rem;
		padding: 2rem;
		border: 1px solid #eef1f4;
		box-shadow: 0 4px 15px rgba(0,0,0,0.02);
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.profile-avatar {
		width: 80px;
		height: 80px;
		background-color: #e6f2f0;
		color: #0d7a6e;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		font-weight: 800;
		border: 3px solid #ffffff;
		box-shadow: 0 0 0 2px #0d7a6e;
		flex-shrink: 0;
	}

	.profile-info h2 {
		font-weight: 800;
		color: #1a2733;
		margin-bottom: 0.25rem;
		font-size: 1.5rem;
		letter-spacing: -0.5px;
	}

	.profile-info .email {
		color: #5a6571;
		font-size: 0.95rem;
		margin-bottom: 0.5rem;
	}

	.badge-role {
		background-color: #e6f2f0;
		color: #0d7a6e;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	/* --- Dashboard Cards --- */
	.dashboard-card {
		background: #ffffff;
		border-radius: 0.75rem;
		border: 1px solid #e6e9ee;
		padding: 1.5rem;
		height: 100%;
		transition: transform 0.2s, box-shadow 0.2s;
	}

		.dashboard-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 25px rgba(0,0,0,0.05);
		}

		.dashboard-card .card-icon {
			width: 48px;
			height: 48px;
			border-radius: 0.5rem;
			display: flex;
			align-items: center;
			justify-content: center;
			margin-bottom: 1.25rem;
		}

		.dashboard-card h4 {
			font-size: 1.1rem;
			font-weight: 800;
			color: #1a2733;
			margin-bottom: 0.5rem;
		}

		.dashboard-card p {
			color: #5a6571;
			font-size: 0.9rem;
			margin-bottom: 1.25rem;
			line-height: 1.5;
		}

	/* --- Custom Buttons --- */
	.btn-edu-action {
		background-color: #f8f9fb;
		color: #0d7a6e;
		border: 1px solid #e6e9ee;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
		border-radius: 0.375rem;
		transition: 0.2s;
		display: inline-block;
		text-decoration: none;
	}

		.btn-edu-action:hover {
			background-color: #0d7a6e;
			color: #ffffff;
			border-color: #0d7a6e;
		}

	.btn-edu-primary {
		background-color: #0d7a6e;
		color: #ffffff;
		border: 1px solid #0d7a6e;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
		border-radius: 0.375rem;
		transition: 0.2s;
		display: inline-block;
		text-decoration: none;
	}

		.btn-edu-primary:hover {
			background-color: #095e54;
			color: #ffffff;
		}

	/* --- Status Message --- */
	.alert-success-custom {
		background-color: #e6f2f0;
		color: #0d7a6e;
		border: 1px solid #cce5e2;
		border-radius: 0.375rem;
		padding: 1rem;
		margin-bottom: 2rem;
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
</style>

<div class="dashboard-bg">
	<div class="container">

		<!-- Status Message (e.g. "Password changed successfully") -->
		@if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
		{
			<div class="alert-success-custom shadow-sm">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
					<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
				</svg>
				@ViewBag.StatusMessage
			</div>
		}

		<!-- Profile Header -->
		<div class="profile-header">
			<div class="profile-avatar">
				@(User.Identity.GetUserName().Substring(0, 1).ToUpper())
			</div>
			<div class="profile-info">
				<span class="badge-role mb-2 d-inline-block">
					@if (User.IsInRole("Admin"))
					{<text>Administrator</text> }
				else
				{ <text>Learner</text>}
				</span>
				<h2>My Account</h2>
				<div class="email">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-envelope me-1" viewBox="0 0 16 16">
						<path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
					</svg>
					@User.Identity.GetUserName()
				</div>
			</div>
		</div>

		<!-- Settings Grid -->
		<div class="row g-4">

			<!-- Card 1: Password -->
			<div class="col-md-6 col-lg-3">
				<div class="dashboard-card">
					<div class="card-icon" style="background-color: #f0f7f4; color: #0d7a6e;">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
							<path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z" />
							<path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 1 1 9.5 6.5z" />
						</svg>
					</div>
					<h4>Password</h4>
					<p>Manage your password to keep your EduAccess account secure.</p>
					@if (Model.HasPassword)
					{
						@Html.ActionLink("Change Password", "ChangePassword", "Manage", null, new { @class = "btn-edu-action" })
					}
					else
					{
						@Html.ActionLink("Create Password", "SetPassword", "Manage", null, new { @class = "btn-edu-primary" })
					}
				</div>
			</div>

			<!-- Card 2: External Logins -->
			<div class="col-md-6 col-lg-3">
				<div class="dashboard-card">
					<div class="card-icon" style="background-color: #eef5fc; color: #1f78d1;">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-link-45deg" viewBox="0 0 16 16">
							<path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1.002 1.002 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4.018 4.018 0 0 1-.128-1.287z" />
							<path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243L6.586 4.672z" />
						</svg>
					</div>
					<h4>External Logins</h4>
					<p>You have <strong>@Model.Logins.Count</strong> external provider(s) linked to this account.</p>
					@Html.ActionLink("Manage Logins", "ManageLogins", "Manage", null, new { @class = "btn-edu-action" })
				</div>
			</div>

			<!-- Card 3: Security / 2FA -->
			<div class="col-md-6 col-lg-3">
				<div class="dashboard-card">
					<div class="card-icon" style="background-color: #fff8eb; color: #f5a623;">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-phone" viewBox="0 0 16 16">
							<path d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H5z" />
							<path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" />
						</svg>
					</div>
					<h4>Two-Factor Auth</h4>
					<p>Add an extra layer of security to your account by enabling two-factor authentication.</p>
					<span class="badge bg-light text-muted border">Not Configured</span>
				</div>
			</div>

			<!-- Card 4: Face ID Setup (NEW) -->
			<div class="col-md-6 col-lg-3">
				<div class="dashboard-card">
					<div class="card-icon" style="background-color: #fcebe9; color: #e05545;">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-bounding-box" viewBox="0 0 16 16">
							<path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1h-3zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5zM.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5zm15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5z" />
							<path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
						</svg>
					</div>
					<h4>Face ID Login</h4>
					<p>Log in securely without a password by using facial recognition.</p>

					@if (hasFaceId)
					{
						<span class="badge bg-success mb-3">✓ Enabled</span>
						<br />
						<a href="@Url.Action("SetupFace", "Manage")" class="btn-edu-action mt-2">Update Face Scan</a>
					}
					else
					{
						<span class="badge bg-warning text-dark mb-3">Not Setup</span>
						<br />
						<a href="@Url.Action("SetupFace", "Manage")" class="btn-edu-primary mt-2">Setup Face ID</a>
					}
				</div>
			</div>

		</div>
	</div>
</div>