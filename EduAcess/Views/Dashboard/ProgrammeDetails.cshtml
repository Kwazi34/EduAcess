@using EduAcess.Models
@model Programme
@{
	ViewBag.Title = Model.Name + " Details";
	Layout = "~/Views/Shared/_Layout.cshtml";

	// Build a safe fallback URL since Institution.Website doesn't exist
	string applyUrl = "https://www.google.com/search?q=" + Uri.EscapeDataString(Model.Institution.Name + " online application");
}

<style>
	.hero-programme {
		background: linear-gradient(135deg, #0d7a6e 0%, #095e54 100%);
		color: white;
		padding: 3rem 0;
		margin-bottom: -2rem;
	}

	.detail-card {
		border-radius: 1rem;
		border: 1px solid #eae7e0;
		box-shadow: 0 15px 35px rgba(0,0,0,0.05);
	}

	.sticky-apply {
		position: sticky;
		top: 100px;
	}

	.badge-hero {
		background: rgba(255,255,255,0.2);
		color: white;
		font-size: 0.85rem;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		margin-right: 0.5rem;
	}
</style>

<!-- Hero Section -->
<div class="hero-programme">
	<div class="container">
		<a href="@Url.Action("Index", "Dashboard")" class="text-white text-decoration-none small mb-3 d-inline-block" style="opacity: 0.8;">
			&larr; Back to Dashboard
		</a>
		<h1 class="display-5 fw-bold mb-2">@Model.Name</h1>
		<h4 class="mb-4" style="opacity: 0.9;">@Model.Institution.Name</h4>

		<div>
			<span class="badge-hero">@Model.QualificationType</span>
			<span class="badge-hero">@Model.FieldOfStudy</span>
			<span class="badge-hero">@Model.DurationYears Years</span>
		</div>
	</div>
</div>

<div class="container py-5">
	<div class="row g-4">

		<!-- Left Column: Details -->
		<div class="col-lg-8">
			<div class="card detail-card p-4">
				<h4 class="fw-bold mb-3">About this Programme</h4>
				<p class="text-muted" style="font-size: 1.05rem; line-height: 1.7;">
					This is a <strong>@Model.QualificationType</strong> programme in <strong>@Model.FieldOfStudy</strong> offered at <strong>@Model.Institution.Name</strong>.
					The full duration of this programme is <strong>@Model.DurationYears years</strong>.
				</p>

				<hr class="my-4" />

				<h4 class="fw-bold mb-3">Admission Requirements</h4>

				<!-- APS Requirement Banner -->
				<div class="p-3 mb-4 rounded" style="background-color: #f8fafc; border-left: 4px solid #0d7a6e;">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<span class="text-muted small d-block">Minimum APS Required</span>
							<strong style="font-size: 1.5rem; color: #0d7a6e;">@Model.RequiredAps</strong>
						</div>
					</div>
				</div>

				<div class="alert alert-info border-0">
					<strong>💡 Tip:</strong> <a href="@Url.Action("Onboarding", "Dashboard")" class="alert-link">Go to your Dashboard</a> to see if you qualify for this programme based on your APS.
				</div>

				@if (!string.IsNullOrEmpty(Model.RequiredSubjects))
				{
					<h5 class="fw-bold mt-4 mb-2">Required Subjects</h5>
					<ul class="list-group list-group-flush mb-4">
						<li class="list-group-item bg-transparent px-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#0d7a6e" viewBox="0 0 16 16" class="me-2">
								<path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z" />
							</svg>
							@Model.RequiredSubjects
						</li>
					</ul>
				}

				<h5 class="fw-bold mt-4 mb-2">About @Model.Institution.Name</h5>
				<p class="text-muted">
					@Model.Institution.Name is a @Model.Institution.Type institution located in the @Model.Institution.Province province.
				</p>
			</div>
		</div>

		<!-- Right Column: Action Card -->
		<div class="col-lg-4">
			<div class="card detail-card sticky-apply">
				<div class="card-body p-4">
					<h5 class="fw-bold mb-3">Ready to apply?</h5>
					<p class="text-muted small mb-4">
						Find the official application portal for @Model.Institution.Name.
					</p>

					<!-- WORKING APPLY BUTTON -->
					<a href="@applyUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success w-100 mb-2 py-2 fw-bold" style="background-color: #0d7a6e; border-color: #0d7a6e;">
						Find Application Portal &rarr;
					</a>

					<a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary w-100">
						Keep Browsing
					</a>

					<hr class="my-4" />

					<button onclick="shareProgramme()" class="btn btn-outline-primary w-100">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
							<path d="M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z" />
						</svg>
						Share this Programme
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
        function shareProgramme() {
            const link = window.location.href;
            const title = "@Html.Raw(Model.Name) at @Html.Raw(Model.Institution.Name)";

            if (navigator.share) {
                navigator.share({
                    title: title,
                    text: "Check out this programme on EduAccess!",
                    url: link
                }).catch(err => console.log(err));
            } else {
                navigator.clipboard.writeText(link).then(() => {
                    alert('🔗 Link copied! Share it with your friends:\n' + link);
                });
            }
        }
	</script>
}