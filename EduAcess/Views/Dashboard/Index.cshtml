@using EduAcess.Models
@model DashboardViewModel
@{
	ViewBag.Title = "My Dashboard";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	body {
		background-color: #f8fafc;
	}

	/* Card Animations */
	.match-card {
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
		border: 1px solid #e2e8f0 !important;
	}

		.match-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 24px -10px rgba(0,0,0,0.1) !important;
			border-color: #cbd5e1 !important;
		}

	.direct-card {
		border-left: 4px solid #0d7a6e !important;
	}

	.recommend-card {
		border-left: 4px solid #3b82f6 !important;
		background-color: #f8fafc;
	}

	/* Sticky Sidebar */
	.sticky-sidebar {
		position: sticky;
		top: 100px;
		z-index: 10;
	}

	/* Live Search Bar */
	.search-wrapper {
		position: relative;
		max-width: 400px;
	}

		.search-wrapper input {
			padding-left: 2.5rem;
			border-radius: 999px;
			border: 1px solid #cbd5e1;
			transition: all 0.2s;
		}

			.search-wrapper input:focus {
				border-color: #0d7a6e;
				box-shadow: 0 0 0 3px rgba(13, 122, 110, 0.1);
			}

		.search-wrapper svg {
			position: absolute;
			left: 1rem;
			top: 50%;
			transform: translateY(-50%);
			color: #64748b;
		}

	/* Micro-interaction for badges */
	.status-badge {
		transition: transform 0.2s;
	}

	.match-card:hover .status-badge {
		transform: scale(1.05);
	}
</style>

<div class="container mt-5 mb-5">
	<div class="row">

		<!-- LEFT SIDEBAR (Sticky) -->
		<div class="col-lg-3 mb-4">
			<div class="sticky-sidebar">

				<!-- User Profile Card -->
				<div class="card shadow-sm border-0 mb-4">
					<div class="card-body text-center p-4">
						<div class="mb-3 d-flex justify-content-center">
							<div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 70px; height: 70px; background-color: #0d7a6e !important;">
								@Model.UserName.Substring(0, 1).ToUpper()
							</div>
						</div>
						<h5 class="mb-1">@Model.UserName</h5>
						<p class="text-muted small mb-3">@Model.Interests</p>

						<hr />

						<div class="d-flex justify-content-between mb-2">
							<span class="text-muted small">Current APS</span>
							<strong class="text-success fs-5">@Model.APS</strong>
						</div>
						<div class="d-flex justify-content-between mb-2">
							<span class="text-muted small">Income Level</span>
							<strong class="small text-dark">@Model.HouseholdIncome</strong>
						</div>

						<a href="@Url.Action("Onboarding", "Dashboard")" class="btn btn-outline-secondary w-100 mt-3 btn-sm">
							✏️ Edit Study Passport
						</a>
					</div>
				</div>

				<!-- Plan B Promo -->
				<div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-left: 4px solid #f59e0b !important;">
					<div class="card-body p-4">
						<h6 class="fw-bold" style="color: #92400e;">Not quite qualifying?</h6>
						<p class="small mb-3" style="color: #b45309;">Don't worry! Explore your Plan B options to see exactly how many APS points you need to get there.</p>
						<a href="@Url.Action("ExplorePlanB", "Dashboard")" class="btn btn-warning w-100 fw-bold text-dark btn-sm">
							Explore Plan B
						</a>
					</div>
				</div>

			</div>
		</div>

		<!-- RIGHT CONTENT AREA -->
		<div class="col-lg-9">

			<!-- Top Toolbar (Search + Filters) -->
			<div class="card shadow-sm border-0 mb-4">
				<div class="card-body p-3">
					<div class="row g-3 align-items-center">
						<div class="col-md-4">
							<div class="search-wrapper w-100">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
									<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
								</svg>
								<input type="text" id="liveSearch" class="form-control" placeholder="Search programmes or institutions...">
							</div>
						</div>
						<div class="col-md-8">
							<form method="get" class="row g-2">
								<div class="col-4">
									@Html.DropDownList("fieldOfStudy", Model.FieldOptions, "All Fields", new { @class = "form-select form-select-sm", onchange = "this.form.submit()" })
								</div>
								<div class="col-4">
									@Html.DropDownList("province", Model.ProvinceOptions, "All Provinces", new { @class = "form-select form-select-sm", onchange = "this.form.submit()" })
								</div>
								<div class="col-4">
									@Html.DropDownList("institution", Model.InstitutionOptions, "All Institutions", new { @class = "form-select form-select-sm", onchange = "this.form.submit()" })
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>

			<!-- 1. DIRECT MATCHES -->
			<h3 class="mb-2 mt-4 d-flex align-items-center" id="directMatchesHeader">
				<span class="me-2">🎯</span> Direct Matches
			</h3>
			<p class="text-muted small mb-4">Programmes you qualify for that align with your interests.</p>

			<div class="row" id="directMatchesGrid">
				@if (!Model.Matches.Any())
				{
					<div class="col-12">
						<div class="alert alert-info border-0 shadow-sm">
							No direct matches found based on your interests. Check out your <strong>Plan B</strong> options.
						</div>
					</div>
				}
				else
				{
					foreach (var match in Model.Matches)
					{
						<div class="col-md-6 mb-3 match-item" data-search="@match.Name @match.Institution">
							<a href="@Url.Action("ProgrammeDetails", "Dashboard", new { id = match.Id })" class="text-decoration-none text-dark d-block h-100">
								<div class="card h-100 shadow-sm match-card direct-card">
									<div class="card-body">
										<div class="d-flex justify-content-between align-items-start">
											<div>
												<h5 class="card-title mb-1 fw-bold text-dark">@match.Name</h5>
												<p class="text-muted small mb-2">@match.Institution &middot; @match.QualificationType</p>
											</div>
											<span class="badge bg-success status-badge">Qualified</span>
										</div>
										<div class="mt-3">
											<span class="badge bg-light text-dark border me-1">APS: @Model.APS</span>
											@if (match.NSFAS)
											{
												<span class="badge bg-info text-dark">NSFAS Funded</span>
											}
										</div>
										<div class="mt-3 text-end text-success small fw-bold">
											View Details &rarr;
										</div>
									</div>
								</div>
							</a>
						</div>
					}
				}
			</div>

			<!-- 2. SMART RECOMMENDATIONS -->
			@if (Model.RecommendedMatches.Any())
			{
				<h3 class="mb-2 mt-5 d-flex align-items-center" id="recommendationsHeader">
					<span class="me-2">💡</span> You also qualify for...
				</h3>
				<p class="text-muted small mb-4">These are outside your selected interests, but you qualify for them. You might discover something new!</p>

				<div class="row" id="recommendationsGrid">
					@foreach (var match in Model.RecommendedMatches)
					{
						<div class="col-md-6 mb-3 match-item" data-search="@match.Name @match.Institution">
							<a href="@Url.Action("ProgrammeDetails", "Dashboard", new { id = match.Id })" class="text-decoration-none text-dark d-block h-100">
								<div class="card h-100 shadow-sm match-card recommend-card">
									<div class="card-body">
										<div class="d-flex justify-content-between align-items-start">
											<div>
												<h5 class="card-title mb-1 fw-bold text-dark">@match.Name</h5>
												<p class="text-muted small mb-2">@match.Institution &middot; @match.QualificationType</p>
											</div>
											<span class="badge bg-primary text-white status-badge">Qualified</span>
										</div>
										<div class="mt-3">
											<span class="badge bg-light text-dark border me-1">Field: @match.FieldOfStudy</span>
											@if (match.NSFAS)
											{
												<span class="badge bg-info text-dark">NSFAS Funded</span>
											}
										</div>
										<div class="mt-3 text-end text-primary small fw-bold">
											View Details &rarr;
										</div>
									</div>
								</div>
							</a>
						</div>
					}
				</div>
			}

			<!-- Empty State for Search -->
			<div id="noResults" class="text-center py-5 d-none">
				<h4 class="text-muted">No programmes found matching your search.</h4>
				<p class="text-muted small">Try searching for a different course name or university.</p>
			</div>

		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const searchInput = document.getElementById("liveSearch");
			const matchItems = document.querySelectorAll(".match-item");
			const directHeader = document.getElementById("directMatchesHeader");
			const recHeader = document.getElementById("recommendationsHeader");
			const noResults = document.getElementById("noResults");

			searchInput.addEventListener("input", function (e) {
				const searchTerm = e.target.value.toLowerCase();
				let visibleDirect = 0;
				let visibleRec = 0;

				matchItems.forEach(item => {
					const searchData = item.getAttribute("data-search").toLowerCase();

					if (searchData.includes(searchTerm)) {
						item.style.display = "block";

						// Count what's visible to toggle headers
						if (item.closest("#directMatchesGrid")) visibleDirect++;
						if (item.closest("#recommendationsGrid")) visibleRec++;
					} else {
						item.style.display = "none";
					}
				});

				// Toggle empty state
				if (visibleDirect === 0 && visibleRec === 0) {
					noResults.classList.remove("d-none");
				} else {
					noResults.classList.add("d-none");
				}

				// Hide/show headers based on search
				if (directHeader) directHeader.style.display = visibleDirect > 0 || searchTerm === "" ? "flex" : "none";
				if (recHeader) recHeader.style.display = visibleRec > 0 || searchTerm === "" ? "flex" : "none";
			});
		});
	</script>
}