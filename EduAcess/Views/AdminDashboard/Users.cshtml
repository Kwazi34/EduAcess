@model IEnumerable<EduAcess.Models.ApplicationUser>
@using Microsoft.AspNet.Identity
@{
	ViewBag.Title = "Manage Users";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
	/* --- Data Table Styling --- */
	.admin-table-card {
		background: #ffffff;
		border: 1px solid #e6e9ee;
		border-radius: 0.5rem;
		overflow: hidden;
	}

	.admin-table-header {
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid #e6e9ee;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

		.admin-table-header h5 {
			margin: 0;
			font-weight: 700;
			color: #1a2733;
			font-size: 1.1rem;
		}

	.table-custom {
		margin-bottom: 0;
	}

		.table-custom th {
			background-color: #ffffff;
			color: #5a6571;
			font-weight: 600;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.5px;
			border-top: none;
			border-bottom: 1px solid #e6e9ee;
			padding: 1rem 1.5rem;
		}

		.table-custom td {
			padding: 1rem 1.5rem;
			vertical-align: middle;
			border-bottom: 1px solid #f0f2f5;
			font-size: 0.9rem;
		}

	.badge-role {
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
	}

		.badge-role.admin {
			background-color: #e6f2f0;
			color: #0d7a6e;
		}

		.badge-role.learner {
			background-color: #eef5fc;
			color: #1f78d1;
		}

	/* Status Dots */
	.status-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		margin-right: 6px;
	}

		.status-dot.active {
			background-color: #22c55e;
		}

		.status-dot.pending {
			background-color: #f5a623;
		}
</style>

<div class="container-fluid mt-4">

	<!-- Page Header -->
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold mb-1" style="color: #1a2733;">Manage Users</h2>
			<p class="text-muted mb-0">View all registered learners and administrators.</p>
		</div>
		<a href="@Url.Action("Index", "AdminDashboard")" class="btn btn-outline-secondary">
			&larr; Back to Overview
		</a>
	</div>

	<!-- Users Table -->
	<div class="admin-table-card shadow-sm">
		<div class="admin-table-header">
			<h5>All Users (@Model.Count())</h5>

			<!-- Optional Search Input -->
			<input type="text" id="userSearch" class="form-control form-control-sm" placeholder="Search by name or email..." style="width: 250px; border-radius: 999px;" />
		</div>

		<div class="table-responsive">
			<table class="table table-custom table-hover" id="usersTable">
				<thead>
					<tr>
						<th>User / Email</th>
						<th>Phone</th>
						<th>Role</th>
						<th>Status</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						foreach (var user in Model)
						{
							<tr class="user-row">
								<td>
									<div class="d-flex align-items-center gap-2">
										<div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-weight: bold; font-size: 0.9rem; color: #1f78d1;">
											@(user.Email.Substring(0, 1).ToUpper())
										</div>
										<div>
											<span class="fw-bold d-block" style="font-size: 0.9rem; color: #1a2733;">@(user.FullName ?? user.UserName)</span>
											<small class="text-muted">@user.Email</small>
										</div>
									</div>
								</td>
								<td class="text-muted">
									@(string.IsNullOrEmpty(user.PhoneNumber) ? "Not provided" : user.PhoneNumber)
								</td>
								<td>
									@if (User.IsInRole("Admin") && user.Email == User.Identity.Name)
									{
										<span class="badge-role admin">Admin (You)</span>
									}
									else
									{
										<span class="badge-role learner">Learner</span>
									}
								</td>
								<td>
									@if (user.EmailConfirmed)
									{
										<span class="text-success" style="font-size: 0.85rem;">
											<span class="status-dot active"></span> Active
										</span>
									}
									else
									{
										<span class="text-warning" style="font-size: 0.85rem;">
											<span class="status-dot pending"></span> Pending
										</span>
									}
								</td>
								<td class="text-end">
									<button class="btn btn-sm btn-light border me-1">View</button>
									<button class="btn btn-sm btn-light border">Edit</button>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="5" class="text-center text-muted py-4">No users found in the database.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// Live search filter for users
		document.getElementById('userSearch').addEventListener('input', function (e) {
			var searchTerm = e.target.value.toLowerCase();
			var rows = document.querySelectorAll('.user-row');

			rows.forEach(function (row) {
				var text = row.textContent.toLowerCase();
				if (text.includes(searchTerm)) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
		});
	</script>
}