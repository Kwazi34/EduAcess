	<div class="modal-dialog modal-lg modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Terms and Conditions — EduAccess</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p><em>Last updated: October 2026</em></p>
				<p>Welcome to EduAccess ("we", "our", "the platform"). These Terms and Conditions govern your use of our website and mobile application. By creating an account, you agree to these terms.</p>

				<h5>1. About EduAccess</h5>
				<p>EduAccess is a free AI-powered guide that helps South African matriculants discover study options, funding, and alternative pathways. We complement NSFAS; we do not replace it.</p>

				<h5>2. Free for learners</h5>
				<p>EduAccess is free for all learners. We will never charge a learner to use the platform or sell their personal data to third parties.</p>

				<h5>3. Your account</h5>
				<p>You are responsible for keeping your login details safe. You agree to provide accurate information about your marks, household income, and personal details. Do not impersonate another person.</p>

				<h5>4. Data & privacy</h5>
				<p>Your marks and profile are stored securely. We never share your individual data with third-party advertisers. See our Privacy Policy for details.</p>

				<h5>5. AI guidance</h5>
				<p>EduAccess uses a hybrid system: deterministic rules for eligibility, and AI for explanations. The AI never makes the final eligibility decision. Always confirm requirements with the institution.</p>

				<h5>6. No guarantee of admission</h5>
				<p>EduAccess provides guidance only. We do not guarantee admission to any programme or approval of any bursary. Applications are ultimately handled by the institutions and funders.</p>

				<h5>7. Verification</h5>
				<p>All bursary listings and programme requirements carry a last-verified date. When we're unsure, we say so. Programme details may change — verify directly with the institution before applying.</p>

				<h5>8. Acceptable use</h5>
				<p>Do not misuse the platform (e.g., scraping, hacking, spamming). We may suspend accounts that violate these terms.</p>

				<h5>9. Changes</h5>
				<p>We may update these terms. Continued use after changes means you accept the new terms.</p>

				<h5>10. Contact</h5>
				<p>Questions? Email us at <a href="mailto:hello@eduaccess.co.za">hello@eduaccess.co.za</a>.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-decline" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-accept" onclick="acceptTermsAndClose('termsModal')">I Accept</button>
			</div>
		</div>
	</div>
</div>

<!-- PRIVACY POLICY MODAL -->
<div class="modal fade terms-modal" id="privacyModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Privacy Policy — EduAccess</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p><em>Last updated: October 2026</em></p>
				<p>At EduAccess, we take your privacy seriously. This policy explains what data we collect, how we use it, and your rights.</p>

				<h5>1. What we collect</h5>
				<p>We collect: your name, email, phone number, marks, household income, and programme preferences.</p>

				<h5>2. How we use it</h5>
				<p>To match you with programmes, bursaries, and Plan B pathways. To show your APS and eligibility. To send deadline reminders (if you opt in).</p>

				<h5>3. What we never do</h5>
				<p>We never sell your data. We never share your individual profile with advertisers. We never send your personal details to third-party AI models beyond what the answer needs.</p>

				<h5>4. Where your data lives</h5>
				<p>Your marks are stored on our secure server, not the AI model. The AI never decides eligibility — only explains it.</p>

				<h5>5. Your rights</h5>
				<p>You can delete your account and all data at any time. You can request a copy of your data. Contact <a href="mailto:hello@eduaccess.co.za">hello@eduaccess.co.za</a>.</p>

				<h5>6. Cookies</h5>
				<p>We use session cookies to keep you logged in. No third-party tracking cookies.</p>

				<h5>7. Minors</h5>
				<p>Most of our users are 16-19. We handle minor data with extra care and never share it without consent.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-decline" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-accept" onclick="acceptTermsAndClose('privacyModal')">I Accept</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		// 1. TOGGLE PASSWORD VISIBILITY
		function togglePassword(inputId, btn) {
			var input = document.getElementById(inputId);
			if (input.type === "password") {
				input.type = "text";
				btn.textContent = "Hide";
			} else {
				input.type = "password";
				btn.textContent = "Show";
			}
		}

		// 2. LIVE NAME VALIDATION
		function validateName(fieldId) {
			var field = document.getElementById(fieldId);
			var icon = document.getElementById(fieldId + 'Icon');
			var value = field.value.trim();

			if (value.length === 0) {
				field.classList.remove('is-valid', 'is-invalid');
				icon.textContent = '';
				return;
			}

			if (value.length >= 2 && /^[a-zA-Z\u00C0-\u024F\s'-]+$/.test(value)) {
				field.classList.add('is-valid');
				field.classList.remove('is-invalid');
				icon.textContent = '✓';
				icon.className = 'validation-icon valid';
			} else {
				field.classList.add('is-invalid');
				field.classList.remove('is-valid');
				icon.textContent = '✕';
				icon.className = 'validation-icon invalid';
			}
		}

		// 3. LIVE PHONE VALIDATION
		function validatePhone() {
			var phone = document.getElementById('phone');
			var icon = document.getElementById('phoneIcon');
			var hint = document.getElementById('phoneHint');
			var value = phone.value.replace(/[\s\-\(\)]/g, '');

			if (value.length === 0) {
				phone.classList.remove('is-valid', 'is-invalid');
				icon.textContent = '';
				hint.textContent = '';
				return;
			}

			var valid = /^(\+27|0)[6-8][0-9]{8}$/.test(value);

			if (valid) {
				phone.classList.add('is-valid');
				phone.classList.remove('is-invalid');
				icon.textContent = '✓';
				icon.className = 'validation-icon valid';
				hint.textContent = 'Valid South African phone number';
				hint.style.color = '#0d7a6e';
			} else {
				phone.classList.add('is-invalid');
				phone.classList.remove('is-valid');
				icon.textContent = '✕';
				icon.className = 'validation-icon invalid';
				hint.textContent = 'Format: +27 82 123 4567 or 082 123 4567';
				hint.style.color = '#e05545';
			}
		}

		// 4. LIVE EMAIL VALIDATION
		function validateEmail() {
			var email = document.getElementById('email');
			var icon = document.getElementById('emailIcon');
			var hint = document.getElementById('emailHint');
			var value = email.value.trim();

			if (value.length === 0) {
				email.classList.remove('is-valid', 'is-invalid');
				icon.textContent = '';
				hint.textContent = '';
				return;
			}

			var regex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
			if (regex.test(value)) {
				email.classList.add('is-valid');
				email.classList.remove('is-invalid');
				icon.textContent = '✓';
				icon.className = 'validation-icon valid';
				hint.textContent = 'Valid email address';
				hint.style.color = '#0d7a6e';
			} else {
				email.classList.add('is-invalid');
				email.classList.remove('is-valid');
				icon.textContent = '✕';
				icon.className = 'validation-icon invalid';
				hint.textContent = 'Please enter a valid email (e.g., name@@example.com)';
				hint.style.color = '#e05545';
			}
		}

		// 5. LIVE PASSWORD STRENGTH METER
		function checkPasswordStrength() {
			var password = document.getElementById('passwordInput').value;
			var bar = document.getElementById('strengthBar');
			var label = document.getElementById('strengthLabel');

			if (password.length === 0) {
				bar.style.width = '0%';
				label.textContent = '';
				return;
			}

			var score = 0;
			if (password.length >= 6) score++;
			if (password.length >= 10) score++;
			if (/[a-z]/.test(password)) score++;
			if (/[A-Z]/.test(password)) score++;
			if (/[0-9]/.test(password)) score++;
			if (/[^a-zA-Z0-9]/.test(password)) score++;

			var percent = (score / 6) * 100;
			bar.style.width = percent + '%';

			if (score <= 2) {
				bar.style.background = '#e05545';
				label.textContent = 'Weak password';
				label.style.color = '#e05545';
			} else if (score <= 4) {
				bar.style.background = '#f5a623';
				label.textContent = 'Medium password';
				label.style.color = '#f5a623';
			} else {
				bar.style.background = '#0d7a6e';
				label.textContent = 'Strong password ✓';
				label.style.color = '#0d7a6e';
			}
		}

		// 6. LIVE PASSWORD MATCH CHECK
		function checkPasswordMatch() {
			var password = document.getElementById('passwordInput').value;
			var confirm = document.getElementById('confirmPasswordInput');
			var hint = document.getElementById('matchHint');

			if (confirm.value.length === 0) {
				confirm.classList.remove('is-valid', 'is-invalid');
				hint.textContent = '';
				return;
			}

			if (password === confirm.value) {
				confirm.classList.add('is-valid');
				confirm.classList.remove('is-invalid');
				hint.textContent = '✓ Passwords match';
				hint.style.color = '#0d7a6e';
			} else {
				confirm.classList.add('is-invalid');
				confirm.classList.remove('is-valid');
				hint.textContent = '✕ Passwords do not match';
				hint.style.color = '#e05545';
			}
		}

		// 7. SYNC TERMS CHECKBOX (FIXED)
		function syncTermsCheckbox(checkbox) {
			var hidden = document.getElementById('AcceptTermsHidden');
			if (hidden) {
				hidden.value = checkbox.checked ? 'true' : 'false';
			}
			updateSubmitButton();
		}

		// 8. UPDATE SUBMIT BUTTON
		function updateSubmitButton() {
			var checkbox = document.getElementById('termsCheckbox');
			var btn = document.getElementById('submitBtn');
			var text = document.getElementById('submitText');

			if (checkbox.checked) {
				btn.disabled = false;
				text.textContent = 'Create Account →';
			} else {
				btn.disabled = true;
				text.textContent = 'Please accept the terms';
			}
		}

		// 9. ACCEPT TERMS FROM MODAL (FIXED)
		function acceptTermsAndClose(modalId) {
			var checkbox = document.getElementById('termsCheckbox');
			if (checkbox) {
				checkbox.checked = true;
				// Trigger the sync
				syncTermsCheckbox(checkbox);
			}

			var modalEl = document.getElementById(modalId);
			if (modalEl) {
				var modal = bootstrap.Modal.getInstance(modalEl);
				if (!modal) {
					modal = new bootstrap.Modal(modalEl);
				}
				modal.hide();
			}

			setTimeout(function () {
				document.querySelectorAll('.modal-backdrop').forEach(function (b) { b.remove(); });
				document.body.classList.remove('modal-open');
				document.body.style.overflow = '';
				document.body.style.paddingRight = '';
			}, 300);
		}

		// Initialize button state on page load
		document.addEventListener('DOMContentLoaded', function () {
			// Make sure the checkbox is in sync on load
			var checkbox = document.getElementById('termsCheckbox');
			if (checkbox) {
				syncTermsCheckbox(checkbox);
			}
		});
	</script>
}