@{
	ViewBag.Title = "Email Sent";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.body-content {
		padding-top: 0 !important;
		padding-bottom: 0 !important;
	}

	.auth-page-wrapper {
		min-height: calc(100vh - 73px);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #faf9f6;
		padding: 2rem;
	}

	.confirm-card {
		max-width: 500px;
		width: 100%;
		background: #ffffff;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		border: 1px solid #eae7e0;
		padding: 3rem 2.5rem;
		text-align: center;
		animation: fadeIn 0.5s ease-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.icon-circle {
		width: 80px;
		height: 80px;
		background: #e6f2f0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem auto;
		position: relative;
	}

		.icon-circle::after {
			content: '';
			position: absolute;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			border: 2px solid #0d7a6e;
			opacity: 0.3;
			animation: pulse-ring 2s infinite;
		}

	@@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 0.6;
		}

		100% {
			transform: scale(1.4);
			opacity: 0;
		}
	}

	.confirm-card h2 {
		font-size: 1.75rem;
		font-weight: 800;
		color: #1a2733;
		margin-bottom: 0.75rem;
	}

	.confirm-card p {
		color: #5a6571;
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

		.confirm-card p strong {
			color: #1a2733;
		}

	.btn-primary-custom {
		background-color: #0d7a6e;
		color: white;
		font-weight: 700;
		padding: 0.85rem 1.5rem;
		border-radius: 0.375rem;
		text-decoration: none;
		display: inline-block;
		transition: 0.2s;
		width: 100%;
		border: none;
		font-size: 1rem;
	}

		.btn-primary-custom:hover {
			background-color: #095e54;
			color: white;
		}

	.btn-outline-custom {
		background: transparent;
		color: #5a6571;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: 0.375rem;
		text-decoration: none;
		display: inline-block;
		transition: 0.2s;
		width: 100%;
		margin-top: 0.5rem;
	}

		.btn-outline-custom:hover {
			color: #1a2733;
			background-color: #f8f9fa;
		}

	.spam-note {
		background: #fff8eb;
		border: 1px solid #fde68a;
		border-radius: 0.375rem;
		padding: 0.75rem 1rem;
		margin-top: 1.5rem;
		font-size: 0.8rem;
		color: #92400e;
		text-align: left;
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
</style>

<div class="auth-page-wrapper">
	<div class="confirm-card">

		<!-- Animated Check Circle Icon -->
		<div class="icon-circle">
			<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="#0d7a6e" viewBox="0 0 16 16">
				<path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
			</svg>
		</div>

		<h2>Check your inbox</h2>
		<p>
			We've sent a password reset link to the email you provided. <br />
			<strong>Please check your inbox.</strong>
		</p>

		<a href="@Url.Action("Login", "Account")" class="btn-primary-custom">
			Back to Login
		</a>

		<a href="@Url.Action("ForgotPassword", "Account")" class="btn-outline-custom">
			Didn't receive it? Try again
		</a>

		<!-- Spam Note -->
		<div class="spam-note">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="flex-shrink: 0;">
				<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.765.98 1.765h14.11c.89 0 1.437-.987.98-1.765L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
			</svg>
			<span>
				<b>Tip:</b> Don't see the email? Check your <b>Spam</b> or <b>Junk</b> folder. It can take up to 5 minutes to arrive.
			</span>
		</div>

	</div>
</div>