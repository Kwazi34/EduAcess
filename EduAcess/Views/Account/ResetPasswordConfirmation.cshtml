@{
	ViewBag.Title = "Password Reset Successful";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.body-content {
		padding-top: 0 !important;
		padding-bottom: 0 !important;
	}

	.auth-page-wrapper {
		min-height: calc(100vh - 73px);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #faf9f6;
		padding: 2rem;
	}

	.confirm-card {
		max-width: 500px;
		width: 100%;
		background: #ffffff;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		border: 1px solid #eae7e0;
		padding: 3rem 2.5rem;
		text-align: center;
		animation: fadeIn 0.5s ease-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.icon-circle {
		width: 80px;
		height: 80px;
		background: #e6f2f0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem auto;
		position: relative;
	}

		.icon-circle::after {
			content: '';
			position: absolute;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			border: 2px solid #0d7a6e;
			opacity: 0.3;
			animation: pulse-ring 2s infinite;
		}

	@@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 0.6;
		}

		100% {
			transform: scale(1.4);
			opacity: 0;
		}
	}

	.confirm-card h2 {
		font-size: 1.75rem;
		font-weight: 800;
		color: #1a2733;
		margin-bottom: 0.75rem;
	}

	.confirm-card p {
		color: #5a6571;
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.btn-primary-custom {
		background-color: #0d7a6e;
		color: white;
		font-weight: 700;
		padding: 0.85rem 1.5rem;
		border-radius: 0.375rem;
		text-decoration: none;
		display: inline-block;
		transition: 0.2s;
		width: 100%;
		border: none;
		font-size: 1rem;
	}

		.btn-primary-custom:hover {
			background-color: #095e54;
			color: white;
		}
</style>

<div class="auth-page-wrapper">
	<div class="confirm-card">

		<!-- Animated Check Mark Icon -->
		<div class="icon-circle">
			<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="#0d7a6e" viewBox="0 0 16 16">
				<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
			</svg>
		</div>

		<h2>Password reset successful</h2>
		<p>
			Your password has been updated successfully. You can now log in with your new password.
		</p>

		<a href="@Url.Action("Login", "Account")" class="btn-primary-custom">
			Log in to EduAccess
		</a>

	</div>
</div>