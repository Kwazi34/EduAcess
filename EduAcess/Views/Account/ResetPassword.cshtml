@model EduAcess.Models.ResetPasswordViewModel
@{
	ViewBag.Title = "Reset Password";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.body-content {
		padding-top: 0 !important;
		padding-bottom: 0 !important;
	}

	.auth-page-wrapper {
		min-height: calc(100vh - 73px);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #faf9f6;
		padding: 2rem;
	}

	.auth-card {
		display: flex;
		width: 100%;
		max-width: 950px;
		background: #ffffff;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		border: 1px solid #eae7e0;
		overflow: hidden;
		min-height: 600px;
	}

	.auth-left {
		flex: 0 0 45%;
		padding: 4rem 3rem;
		background: radial-gradient(circle at 20% 20%, #f0f7f4, #e4f0ec 60%);
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

		.auth-left::before {
			content: '';
			position: absolute;
			width: 280px;
			height: 280px;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(13,122,110,0.08), transparent 70%);
			top: -60px;
			right: -60px;
			animation: float 8s ease-in-out infinite;
		}

	@@keyframes float {
		0%, 100% {
			transform: translate(0, 0);
		}

		50% {
			transform: translate(-15px, 20px);
		}
	}

	.auth-left > * {
		position: relative;
		z-index: 1;
	}

	.auth-left h2 {
		font-size: 2.25rem;
		font-weight: 800;
		color: #1a2733;
		line-height: 1.2;
		margin-bottom: 1rem;
		letter-spacing: -1px;
	}

	.auth-left p {
		color: #5a6571;
		font-size: 1rem;
		line-height: 1.6;
	}

	.auth-right {
		flex: 0 0 55%;
		padding: 3rem 4rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

		.auth-right h3 {
			font-size: 1.75rem;
			font-weight: 800;
			color: #1a2733;
			margin-bottom: 0.5rem;
		}

		.auth-right .subtitle {
			color: #5a6571;
			margin-bottom: 2rem;
			font-size: 0.95rem;
		}

	.form-group-custom {
		margin-bottom: 1.25rem;
	}

		.form-group-custom label {
			font-weight: 600;
			color: #1a2733;
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
			display: block;
		}

	.form-control-custom {
		width: 100%;
		padding: 0.75rem 1rem;
		font-size: 1rem;
		border: 1px solid #cfd6de;
		border-radius: 0.375rem;
		background-color: #fafbfc;
		transition: all 0.2s;
	}

		.form-control-custom:focus {
			background-color: #ffffff;
			border-color: #0d7a6e;
			outline: none;
			box-shadow: 0 0 0 3px rgba(13, 122, 110, 0.1);
		}

	/* Password Wrapper */
	.password-wrapper {
		position: relative;
	}

	.show-password-btn {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: #0d7a6e;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
	}

	.pass-hint {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.78rem;
		color: #a0abb5;
		min-height: 1em;
	}

	.btn-submit {
		background-color: #0d7a6e;
		color: white;
		font-weight: 700;
		padding: 0.85rem;
		border-radius: 0.375rem;
		border: none;
		width: 100%;
		transition: 0.2s;
		margin-top: 0.5rem;
	}

		.btn-submit:hover {
			background-color: #095e54;
		}

	@@media (max-width: 768px) {
		.auth-card {
			flex-direction: column;
		}

		.auth-left {
			display: none;
		}

		.auth-right {
			padding: 2rem;
		}
	}
</style>

<div class="auth-page-wrapper">
	<div class="auth-card">

		<!-- Left Side: Brand -->
		<div class="auth-left">
			<h2>Almost there.</h2>
			<p>Create a strong new password to secure your EduAccess account. Make sure it's something you'll remember.</p>
		</div>

		<!-- Right Side: Form -->
		<div class="auth-right">
			<h3>Set a new password</h3>
			<p class="subtitle">Your new password must be at least 6 characters long.</p>

			@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form", id = "resetForm" }))
			{
				@Html.AntiForgeryToken()
				@Html.ValidationSummary("", new { @class = "text-danger small mb-3" })

				@Html.HiddenFor(model => model.Code)

				<div class="form-group-custom">
					@Html.LabelFor(m => m.Email)
					@Html.TextBoxFor(m => m.Email, new { @class = "form-control-custom", placeholder = "name@example.com", type = "email" })
				</div>

				<div class="form-group-custom">
					@Html.LabelFor(m => m.Password)
					<div class="password-wrapper">
						@Html.PasswordFor(m => m.Password, new { @class = "form-control-custom", placeholder = "••••••••", id = "newPassword" })
						<button type="button" class="show-password-btn" onclick="togglePassword('newPassword', this)">Show</button>
					</div>
					<small class="pass-hint" id="passHint"></small>
				</div>

				<div class="form-group-custom">
					@Html.LabelFor(m => m.ConfirmPassword)
					<div class="password-wrapper">
						@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control-custom", placeholder = "••••••••", id = "confirmPassword" })
						<button type="button" class="show-password-btn" onclick="togglePassword('confirmPassword', this)">Show</button>
					</div>
				</div>

				<button type="submit" class="btn-submit" id="submitBtn">
					Reset Password
				</button>
			}

			<div class="text-center mt-4">
				<a href="@Url.Action("Login", "Account")" style="color: #0d7a6e; font-weight: 600; text-decoration: none; font-size: 0.9rem;">
					&larr; Back to Login
				</a>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script>
        // Toggle Show/Hide Password
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var showing = input.type === "text";
            input.type = showing ? "password" : "text";
            btn.textContent = showing ? "Show" : "Hide";
        }

        // Live password strength hint
        var passInput = document.getElementById("newPassword");
        var passHint = document.getElementById("passHint");

        if (passInput && passHint) {
            passInput.addEventListener("input", function () {
                var len = this.value.length;
                if (len === 0) {
                    passHint.textContent = "";
                } else if (len < 6) {
                    var need = 6 - len;
                    passHint.textContent = need + " more character" + (need > 1 ? "s" : "") + " needed";
                    passHint.style.color = "#a0abb5";
                } else {
                    passHint.textContent = "✓ Looks good";
                    passHint.style.color = "#0d7a6e";
                }
            });
        }

        // Submit loading state
        document.getElementById('resetForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.innerText = 'Resetting...';
            btn.disabled = true;
            btn.style.opacity = '0.7';
        });
	</script>
}