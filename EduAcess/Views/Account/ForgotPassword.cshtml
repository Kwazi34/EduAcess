@model EduAcess.Models.ForgotPasswordViewModel
@{
	ViewBag.Title = "Forgot Password";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.body-content {
		padding-top: 0 !important;
		padding-bottom: 0 !important;
	}

	.auth-page-wrapper {
		min-height: calc(100vh - 73px);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #faf9f6;
		padding: 2rem;
	}

	.auth-card {
		display: flex;
		width: 100%;
		max-width: 950px;
		background: #ffffff;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		border: 1px solid #eae7e0;
		overflow: hidden;
		min-height: 550px;
	}

	.auth-left {
		flex: 0 0 45%;
		padding: 4rem 3rem;
		background: radial-gradient(circle at 20% 20%, #f0f7f4, #e4f0ec 60%);
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

		.auth-left::before {
			content: '';
			position: absolute;
			width: 280px;
			height: 280px;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(13,122,110,0.08), transparent 70%);
			top: -60px;
			right: -60px;
			animation: float 8s ease-in-out infinite;
		}

	@@keyframes float {
		0%, 100% {
			transform: translate(0, 0);
		}

		50% {
			transform: translate(-15px, 20px);
		}
	}

	.auth-left > * {
		position: relative;
		z-index: 1;
	}

	.auth-left h2 {
		font-size: 2.25rem;
		font-weight: 800;
		color: #1a2733;
		line-height: 1.2;
		margin-bottom: 1rem;
		letter-spacing: -1px;
	}

	.auth-left p {
		color: #5a6571;
		font-size: 1rem;
		line-height: 1.6;
	}

	.auth-right {
		flex: 0 0 55%;
		padding: 4rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

		.auth-right h3 {
			font-size: 1.75rem;
			font-weight: 800;
			color: #1a2733;
			margin-bottom: 0.5rem;
		}

		.auth-right .subtitle {
			color: #5a6571;
			margin-bottom: 2rem;
			font-size: 0.95rem;
		}

	.form-group-custom {
		margin-bottom: 1.25rem;
	}

		.form-group-custom label {
			font-weight: 600;
			color: #1a2733;
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
			display: block;
		}

	.form-control-custom {
		width: 100%;
		padding: 0.75rem 1rem;
		font-size: 1rem;
		border: 1px solid #cfd6de;
		border-radius: 0.375rem;
		background-color: #fafbfc;
		transition: all 0.2s;
	}

		.form-control-custom:focus {
			background-color: #ffffff;
			border-color: #0d7a6e;
			outline: none;
			box-shadow: 0 0 0 3px rgba(13, 122, 110, 0.1);
		}

	.btn-submit {
		background-color: #0d7a6e;
		color: white;
		font-weight: 700;
		padding: 0.85rem;
		border-radius: 0.375rem;
		border: none;
		width: 100%;
		transition: 0.2s;
		margin-top: 0.5rem;
	}

		.btn-submit:hover {
			background-color: #095e54;
		}

	.alert-success {
		background-color: #e6f2f0;
		color: #0d7a6e;
		border: 1px solid #cce5e2;
		border-radius: 0.375rem;
		padding: 1rem;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
	}

	@@media (max-width: 768px) {
		.auth-card {
			flex-direction: column;
		}

		.auth-left {
			display: none;
		}

		.auth-right {
			padding: 2rem;
		}
	}
</style>

<div class="auth-page-wrapper">
	<div class="auth-card">

		<!-- Left Side: Brand Text -->
		<div class="auth-left">
			<h2>Forgot your<br />password?</h2>
			<p>Don't worry. We'll send a secure link to your email so you can reset it in seconds.</p>
		</div>

		<!-- Right Side: Form -->
		<div class="auth-right">
			<h3>Reset your password</h3>
			<p class="subtitle">Enter the email address linked to your EduAccess account.</p>

			@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", id = "forgotPasswordForm" }))
			{
				@Html.AntiForgeryToken()

				@Html.ValidationSummary("", new { @class = "text-danger small mb-3" })

				<div class="form-group-custom">
					@Html.LabelFor(m => m.Email)
					@Html.TextBoxFor(m => m.Email, new { @class = "form-control-custom", placeholder = "name@example.com", type = "email" })
				</div>

				<button type="submit" class="btn-submit" id="submitBtn">
					Send Reset Link
				</button>
			}

			<div class="text-center mt-4">
				<a href="@Url.Action("Login", "Account")" style="color: #0d7a6e; font-weight: 600; text-decoration: none; font-size: 0.9rem;">
					&larr; Back to Login
				</a>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
	<script>
        // Show loading state on submit
        document.getElementById('forgotPasswordForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.innerText = 'Sending...';
            btn.disabled = true;
            btn.style.opacity = '0.7';
        });
	</script>
}