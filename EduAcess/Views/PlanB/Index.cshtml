@{
	ViewBag.Title = "Plan B Pathways";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	body {
		background-color: #f8f9fa;
		font-family: 'Inter', -apple-system, sans-serif;
	}

	.body-content {
		padding-top: 0 !important;
	}

	.planb-hero {
		background: linear-gradient(135deg, #095e54 0%, #0d7a6e 50%, #20c997 100%);
		color: #fff;
		padding: 4rem 0 6rem 0;
		position: relative;
		overflow: hidden;
	}

		.planb-hero::after {
			content: '';
			position: absolute;
			bottom: -50px;
			right: -50px;
			width: 400px;
			height: 400px;
			background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
			border-radius: 50%;
		}

		.planb-hero h1 {
			font-size: 2.8rem;
			font-weight: 800;
			letter-spacing: -1px;
			margin-bottom: 1rem;
		}

		.planb-hero p {
			font-size: 1.15rem;
			opacity: 0.9;
			max-width: 700px;
		}

	.intro-card {
		background: #fff;
		border-radius: 1rem;
		padding: 2rem;
		border: 1px solid #eae7e0;
		box-shadow: 0 15px 35px rgba(0,0,0,0.08);
		margin-top: -3rem;
		position: relative;
		z-index: 10;
	}

	.pathway-card {
		background: #fff;
		border: 1px solid #eae7e0;
		border-radius: 0.75rem;
		padding: 2rem;
		height: 100%;
		transition: all 0.2s;
		display: flex;
		flex-direction: column;
		cursor: pointer;
		text-decoration: none;
		color: inherit;
	}

		.pathway-card:hover {
			border-color: #0d7a6e;
			box-shadow: 0 15px 35px rgba(13, 122, 110, 0.1);
			transform: translateY(-5px);
			text-decoration: none;
			color: inherit;
		}

		.pathway-card .num {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: #0d7a6e;
			color: #fff;
			font-weight: 800;
			font-size: 1.1rem;
			margin-bottom: 1rem;
		}

		.pathway-card h4 {
			font-weight: 800;
			color: #1a2733;
			font-size: 1.2rem;
			margin-bottom: 0.5rem;
		}

		.pathway-card .time {
			color: #0d7a6e;
			font-weight: 700;
			font-size: 0.85rem;
			margin-bottom: 1rem;
		}

		.pathway-card .desc {
			color: #5a6571;
			font-size: 0.95rem;
			line-height: 1.5;
			flex-grow: 1;
		}

		.pathway-card .arrow {
			color: #0d7a6e;
			font-weight: 700;
			margin-top: 1rem;
			font-size: 0.9rem;
		}

	.route-step {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid #f0f2f5;
	}

		.route-step:last-child {
			border-bottom: none;
		}

		.route-step .circle {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			background: #f0f7f4;
			border: 2px solid #0d7a6e;
			color: #0d7a6e;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 800;
			flex-shrink: 0;
		}

		.route-step .info h6 {
			margin: 0 0 0.25rem 0;
			font-weight: 700;
			color: #1a2733;
		}

		.route-step .info p {
			margin: 0;
			color: #5a6571;
			font-size: 0.9rem;
		}
</style>

<section class="planb-hero">
	<div class="container">
		<h1>Plan B Pathways</h1>
		<p>When the first choice is out of reach, we generate alternative routes. A setback becomes a redirect.</p>
	</div>
</section>

<div class="container pb-5">
	<div class="intro-card mb-5">
		<h3 class="fw-bold mb-2">How Plan B works</h3>
		<p class="text-muted mb-0">
			If you miss the APS for your first-choice programme, EduAccess finds alternative routes that
			still get you to the same goal. Click any pathway below to see the full journey, cost, and duration.
		</p>
	</div>

	<h3 class="fw-bold mb-4">Choose your route</h3>

	<div class="row g-4">
		<div class="col-md-6 col-lg-3">
			<a href="@Url.Action("Details", "PlanB", new { route = "extended" })" class="pathway-card">
				<div class="num">1</div>
				<h4>Extended Programme</h4>
				<div class="time">+1 year</div>
				<div class="desc">Same degree with an added support year — you still graduate with the same qualification.</div>
				<div class="arrow">Learn more &rarr;</div>
			</a>
		</div>

		<div class="col-md-6 col-lg-3">
			<a href="@Url.Action("Details", "PlanB", new { route = "tvet" })" class="pathway-card">
				<div class="num">2</div>
				<h4>TVET, then Articulate</h4>
				<div class="time">2-3 years</div>
				<div class="desc">N4-N6 route that can lead into a diploma or degree through articulation agreements.</div>
				<div class="arrow">Learn more &rarr;</div>
			</a>
		</div>

		<div class="col-md-6 col-lg-3">
			<a href="@Url.Action("Details", "PlanB", new { route = "certificate" })" class="pathway-card">
				<div class="num">3</div>
				<h4>Higher Certificate</h4>
				<div class="time">1 year</div>
				<div class="desc">An entry-level qualification that can lead directly into degree study at the same institution.</div>
				<div class="arrow">Learn more &rarr;</div>
			</a>
		</div>

		<div class="col-md-6 col-lg-3">
			<a href="@Url.Action("Details", "PlanB", new { route = "upgrade" })" class="pathway-card">
				<div class="num">4</div>
				<h4>Improve Your Marks</h4>
				<div class="time">1 year</div>
				<div class="desc">Rewrite your matric subjects to boost your APS, then reapply next cycle.</div>
				<div class="arrow">Learn more &rarr;</div>
			</a>
		</div>
	</div>
</div>