@model IEnumerable<EduAcess.Models.Bursary>
@{
	ViewBag.Title = "Funding & Bursaries";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var householdIncome = (string)ViewBag.HouseholdIncome;
	var nsfasLikely = (bool)ViewBag.NSFASLikely;

	var bursaries = Model.ToList();
	var openBursaries = bursaries
		.Where(b => b.ClosingDate.HasValue && b.ClosingDate >= DateTime.Now)
		.OrderBy(b => b.ClosingDate).ToList();
	var closedBursaries = bursaries
		.Where(b => b.ClosingDate.HasValue && b.ClosingDate < DateTime.Now)
		.OrderByDescending(b => b.ClosingDate).ToList();
}

<style>
	body {
		background-color: #f8f9fa;
		font-family: 'Inter', -apple-system, sans-serif;
		color: #1a2733;
	}

	.body-content {
		padding-top: 0 !important;
	}

	/* --- Hero --- */
	.funding-hero {
		background: linear-gradient(135deg, #095e54 0%, #0d7a6e 50%, #20c997 100%);
		color: #fff;
		padding: 4rem 0 6rem 0;
		position: relative;
		overflow: hidden;
	}

		.funding-hero::after {
			content: '';
			position: absolute;
			bottom: -50px;
			right: -50px;
			width: 400px;
			height: 400px;
			background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
			border-radius: 50%;
		}

		.funding-hero h1 {
			font-size: 2.8rem;
			font-weight: 800;
			letter-spacing: -1px;
			margin-bottom: 1rem;
		}

		.funding-hero p {
			font-size: 1.15rem;
			opacity: 0.9;
			max-width: 700px;
		}

	/* --- NSFAS Card --- */
	.nsfas-card {
		background: #fff;
		border-radius: 1rem;
		padding: 2rem;
		border: 1px solid #eae7e0;
		box-shadow: 0 15px 35px rgba(0,0,0,0.08);
		margin-top: -3rem;
		position: relative;
		z-index: 10;
	}

		.nsfas-card h3 {
			font-size: 1.5rem;
			font-weight: 800;
			margin-bottom: 1rem;
		}

	.nsfas-status {
		padding: 1.25rem 1.5rem;
		border-radius: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

		.nsfas-status.likely {
			background: #d1e7dd;
			color: #0f5132;
			border-left: 5px solid #0d7a6e;
		}

		.nsfas-status.not-likely {
			background: #fff8eb;
			color: #856404;
			border-left: 5px solid #f5a623;
		}

	/* --- Search Bar --- */
	.search-bar-container {
		position: relative;
		max-width: 500px;
		margin-bottom: 2rem;
	}

		.search-bar-container input {
			width: 100%;
			padding: 0.85rem 1rem 0.85rem 3rem;
			border-radius: 999px;
			border: 1px solid #cbd5e1;
			font-size: 1rem;
			transition: 0.2s;
			background: #fff;
		}

			.search-bar-container input:focus {
				border-color: #0d7a6e;
				outline: none;
				box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.1);
			}

		.search-bar-container svg {
			position: absolute;
			left: 1rem;
			top: 50%;
			transform: translateY(-50%);
			color: #94a3b8;
		}

	/* --- Bursary Cards (clickable) --- */
	.bursary-link {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

		.bursary-link:hover {
			text-decoration: none;
			color: inherit;
		}

	.bursary-card {
		background: #fff;
		border: 1px solid #eae7e0;
		border-radius: 0.75rem;
		padding: 1.5rem;
		height: 100%;
		display: flex;
		flex-direction: column;
		transition: all 0.2s;
		cursor: pointer;
	}

		.bursary-card:hover {
			border-color: #0d7a6e;
			box-shadow: 0 10px 30px rgba(13, 122, 110, 0.1);
			transform: translateY(-3px);
		}

		.bursary-card.closed-card {
			opacity: 0.7;
			background: #fafbfc;
		}

			.bursary-card.closed-card:hover {
				transform: none;
				box-shadow: none;
				border-color: #eae7e0;
			}

		/* URGENT CARD */
		.bursary-card.urgent-card {
			border-left: 5px solid #dc3545;
			background: #fffafa;
		}

		.bursary-card .name {
			font-size: 1.1rem;
			font-weight: 800;
			margin-bottom: 0.25rem;
			color: #1a2733;
		}

		.bursary-card .provider {
			color: #0d7a6e;
			font-weight: 700;
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
		}

		.bursary-card .description {
			color: #5a6571;
			font-size: 0.85rem;
			margin-bottom: 1rem;
			flex-grow: 1;
			line-height: 1.5;
		}

		.bursary-card .dates {
			font-size: 0.8rem;
			color: #5a6571;
			margin-bottom: 1rem;
			background: #f8f9fa;
			padding: 0.75rem;
			border-radius: 0.375rem;
			border: 1px solid #eae7e0;
		}

			.bursary-card .dates strong {
				color: #1a2733;
			}

	.badge {
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		display: inline-block;
		margin-right: 0.25rem;
		margin-bottom: 0.25rem;
	}

	.badge-field {
		background: #eef5fc;
		color: #1f78d1;
	}

	.badge-open {
		background: #d1e7dd;
		color: #0f5132;
	}

	.badge-closed {
		background: #f8d7da;
		color: #721c24;
	}

	.badge-urgent {
		background: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c2c7;
		animation: pulse-red 2s infinite;
	}

	@@keyframes pulse-red {
		0% {
			box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
		}

		70% {
			box-shadow: 0 0 0 6px rgba(220, 53, 69, 0);
		}

		100% {
			box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
		}
	}

	.btn-view {
		background-color: #0d7a6e;
		color: #fff;
		font-weight: 600;
		border: none;
		border-radius: 0.375rem;
		padding: 0.6rem 1rem;
		text-decoration: none;
		display: block;
		text-align: center;
		font-size: 0.9rem;
		transition: 0.2s;
		margin-top: 1rem;
	}

	.bursary-card:hover .btn-view {
		background-color: #095e54;
	}

	.no-results {
		display: none;
		text-align: center;
		padding: 3rem;
		background: #fff;
		border-radius: 1rem;
		border: 1px dashed #cbd5e1;
	}
</style>

<!-- Hero -->
<section class="funding-hero">
	<div class="container">
		<h1>Find Your Funding</h1>
		<p>NSFAS, bursaries, and learnerships — all in one place. Click any bursary to see the full details, requirements, and apply link.</p>
	</div>
</section>

<!-- NSFAS Readiness Card -->
<div class="container">
	<div class="nsfas-card">
		<h3>NSFAS Readiness</h3>

		@if (!User.Identity.IsAuthenticated)
		{
			<div class="nsfas-status not-likely">
				<div>
					<strong class="fs-5">Log in to check NSFAS eligibility</strong>
					<div class="mt-1">Create a free account and enter your household income to see if you qualify for NSFAS.</div>
				</div>
				<a href="@Url.Action("Register", "Account")" class="btn btn-warning text-dark fw-bold">Get Started</a>
			</div>
		}
		else if (nsfasLikely)
		{
			<div class="nsfas-status likely">
				<div>
					<strong class="fs-5">✓ Likely Eligible for NSFAS</strong>
					<div class="mt-1">Your household income is under R350,000/year, which meets the NSFAS threshold.</div>
				</div>
				<a href="https://www.nsfas.org.za" target="_blank" rel="noopener noreferrer" class="btn btn-success fw-bold" style="background: #0d7a6e;">Apply on NSFAS</a>
			</div>
		}
		else if (householdIncome == "R350k - R600k")
		{
			<div class="nsfas-status not-likely">
				<div>
					<strong class="fs-5">⚠ Possibly Eligible</strong>
					<div class="mt-1">Your income is above the standard threshold, but you may still qualify if you have a disability.</div>
				</div>
				<a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-warning text-dark fw-bold">Update Income</a>
			</div>
		}
		else
		{
			<div class="nsfas-status not-likely">
				<div>
					<strong class="fs-5">Not Yet Determined</strong>
					<div class="mt-1">Update your household income on your dashboard to check NSFAS readiness.</div>
				</div>
				<a href="@Url.Action("Index", "Dashboard")" class="btn btn-warning text-dark fw-bold">Update Income</a>
			</div>
		}
	</div>
</div>

<!-- Bursaries -->
<div class="container py-5">

	<!-- SEARCH BAR -->
	<div class="search-bar-container mx-auto">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
			<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
		</svg>
		<input type="text" id="liveSearch" placeholder="Search bursaries (e.g., 'Sasol', 'IT', 'NSFAS')...">
	</div>

	<!-- Open Bursaries -->
	<div class="d-flex align-items-center mb-4">
		<h3 class="fw-bold mb-0">Open Bursaries</h3>
		<span class="badge badge-open ms-3" style="font-size: 0.9rem;">@openBursaries.Count</span>
	</div>

	@if (openBursaries.Any())
	{
		<div class="row g-4 mb-5" id="openBursariesGrid">
			@foreach (var b in openBursaries)
			{
				// Calculate days remaining
				var daysLeft = (b.ClosingDate.Value - DateTime.Now).Days;
				var isUrgent = daysLeft <= 14;

				<div class="col-md-6 col-lg-4 bursary-item" data-search="@b.Name @b.Provider @b.FieldOfStudy @b.Description">
					<a href="@Url.Action("Details", "Funding", new { id = b.Id })" class="bursary-link">
						<div class="bursary-card @(isUrgent ? "urgent-card" : "")">
							<div class="name">@b.Name</div>
							<div class="provider">@b.Provider</div>
							<div class="description">@b.Description</div>

							<div class="dates">
								<strong>Opens:</strong> @(b.OpeningDate?.ToString("dd MMM yyyy") ?? "TBD")<br />
								<strong>Closes:</strong> @(b.ClosingDate?.ToString("dd MMM yyyy") ?? "TBD")
							</div>

							<div>
								<span class="badge badge-field">@b.FieldOfStudy</span>
								@if (isUrgent)
								{
									<span class="badge badge-urgent">🔥 Closing in @daysLeft days!</span>
								}
								else
								{
									<span class="badge badge-open">Open</span>
								}
							</div>

							<div class="btn-view">View Details &rarr;</div>
						</div>
					</a>
				</div>
			}
		</div>
	}
	else
	{
		<div class="alert alert-info py-4">No open bursaries at the moment. Check back soon.</div>
	}

	<!-- Empty State for Search -->
	<div class="no-results" id="noResults">
		<h4 class="text-muted mb-2">No bursaries found</h4>
		<p class="text-muted mb-0">Try a different search term like "Engineering" or "Accounting".</p>
	</div>

	<!-- Closed Bursaries -->
	@if (closedBursaries.Any())
	{
		<div class="d-flex align-items-center mb-4 mt-5" id="closedHeader">
			<h3 class="fw-bold mb-0 text-muted">Closed Bursaries</h3>
			<span class="badge badge-closed ms-3" style="font-size: 0.9rem;">@closedBursaries.Count</span>
		</div>

		<div class="row g-4" id="closedBursariesGrid">
			@foreach (var b in closedBursaries)
			{
				<div class="col-md-6 col-lg-4 bursary-item" data-search="@b.Name @b.Provider @b.FieldOfStudy @b.Description">
					<a href="@Url.Action("Details", "Funding", new { id = b.Id })" class="bursary-link">
						<div class="bursary-card closed-card">
							<div class="name">@b.Name</div>
							<div class="provider" style="color: #5a6571;">@b.Provider</div>
							<div class="description">@b.Description</div>

							<div class="dates">
								<strong>Closed on:</strong> @(b.ClosingDate?.ToString("dd MMM yyyy") ?? "TBD")
							</div>

							<div>
								<span class="badge badge-field" style="background: #f0f2f5; color: #5a6571;">@b.FieldOfStudy</span>
								<span class="badge badge-closed">Closed</span>
							</div>
						</div>
					</a>
				</div>
			}
		</div>
	}
</div>

@section Scripts {
	<script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("liveSearch");
            const items = document.querySelectorAll(".bursary-item");
            const noResults = document.getElementById("noResults");
            const closedHeader = document.getElementById("closedHeader");

            searchInput.addEventListener("input", function (e) {
                const term = e.target.value.toLowerCase();
                let visibleCount = 0;
                let visibleClosed = 0;

                items.forEach(item => {
                    const searchData = item.getAttribute("data-search").toLowerCase();
                    if (searchData.includes(term)) {
                        item.style.display = "block";
                        visibleCount++;
                        if (item.closest("#closedBursariesGrid")) visibleClosed++;
                    } else {
                        item.style.display = "none";
                    }
                });

                // Toggle the "No results" state
                if (visibleCount === 0) {
                    noResults.style.display = "block";
                } else {
                    noResults.style.display = "none";
                }

                // Hide the Closed header if no closed bursaries match
                if (visibleClosed === 0 && closedHeader) {
                    closedHeader.style.display = "none";
                } else if (closedHeader) {
                    closedHeader.style.display = "flex";
                }
            });
        });
	</script>
}